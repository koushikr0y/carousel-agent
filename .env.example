# Copy to .env and fill in. Never commit .env.
TOPIC=Godot game development
REGION=US
BRAND=@intentdev

# Free key from https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# EndeavourOS/Arch: use the system Chromium (installed by setup.sh)
CHROMIUM_PATH=/usr/bin/chromium

# Telegram Automation (Optional but recommended for mobile approval)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=

# Only needed later, for Meta Graph API publishing
IG_USER_ID=
IG_ACCESS_TOKEN=
